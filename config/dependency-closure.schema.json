{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neutral-tts:dependency-closure:schema:v1",
  "title": "Neutral TTS exact dependency closure",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "baseline_commit", "source_commit_policy", "project", "policy", "components", "source_candidate"],
  "properties": {
    "schema_version": {"const": "neutral-dependency-closure-v1"},
    "baseline_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_commit_policy": {"const": "RESOLVE_EXACT_COMMIT_ARGUMENT_AT_BUILD"},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name", "license_spdx", "license_status", "public_distribution"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "display_name": {"type": "string", "pattern": "^(?! *$).+$"},
        "license_spdx": {"type": "string", "pattern": "^(?:NOASSERTION|[A-Za-z0-9][A-Za-z0-9.+-]*(?:-[A-Za-z0-9.+-]+)*)$"},
        "license_status": {"type": "string", "pattern": "^(?! *$).+$"},
        "public_distribution": {"const": false}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_audiences", "public_bundle_requires_approval", "source_only"],
      "properties": {
        "allowed_audiences": {"const": ["INTERNAL_SOURCE_REVIEW"]},
        "public_bundle_requires_approval": {"const": true},
        "source_only": {"const": true}
      }
    },
    "source_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audience", "public_distribution", "reason"],
      "properties": {
        "audience": {"const": "INTERNAL_SOURCE_REVIEW"},
        "public_distribution": {"const": false},
        "reason": {"type": "string", "pattern": "^(?! *$).+$"}
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component_id", "display_name", "kind", "source_url", "wheel_url", "source_commit_or_version", "sha256", "license_spdx", "license_status", "bundle", "bundle_reason"],
        "properties": {
          "component_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "display_name": {"type": "string", "pattern": "^(?! *$).+$"},
          "kind": {"type": "string", "pattern": "^(?! *$).+$"},
          "source_url": {"type": ["string", "null"], "pattern": "^[Hh][Tt][Tt][Pp][Ss]?[:][/][/].+$"},
          "wheel_url": {"type": ["string", "null"], "pattern": "^[Hh][Tt][Tt][Pp][Ss]?[:][/][/].+$"},
          "source_commit_or_version": {"type": ["string", "null"], "minLength": 1},
          "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$"},
          "license_spdx": {"type": ["string", "null"], "pattern": "^(?:NOASSERTION|[A-Za-z0-9][A-Za-z0-9.+-]*(?:-[A-Za-z0-9.+-]+)*)$"},
          "license_status": {"type": ["string", "null"], "pattern": "^(?! *$).+$"},
          "bundle": {"type": "boolean"},
          "bundle_reason": {"type": "string", "pattern": "^(?! *$).+$"},
          "notice_required": {"type": "boolean"}
        },
        "allOf": [
          {
            "if": {"properties": {"component_id": {"const": "project-source"}}},
            "then": {
              "properties": {
                "kind": {"const": "source"},
                "source_url": {"const": null},
                "wheel_url": {"const": null},
                "source_commit_or_version": {"const": "RESOLVED_AT_BUILD_FROM_EXACT_COMMIT_ARGUMENT"},
                "sha256": {"const": null},
                "bundle": {"const": true}
              }
            }
          }
        ]
      },
      "contains": {
        "type": "object",
        "required": ["component_id"],
        "properties": {"component_id": {"const": "project-source"}}
      },
      "minContains": 1,
      "maxContains": 1
    }
  }
}
