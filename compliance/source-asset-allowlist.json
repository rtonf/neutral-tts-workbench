{
  "schema_version": "neutral-source-asset-allowlist-v1",
  "default": "deny",
  "source_paths": [
    "AGENTS.md",
    ".gitattributes",
    ".gitignore",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    ".github/workflows/source-checks.yml",
    "pyproject.toml",
    "launch_desktop.pyw",
    "windows_setup.pyw",
    "src/neutral_tts/**/*.py",
    "tests/**/*.py",
    "tools/**/*.py",
    "config/*.json",
    "config/tokenizer-windows-py313.lock.txt",
    "docs/*.md",
    "compliance/*.json",
    "THIRD_PARTY_NOTICES.md",
    "SBOM.cdx.json",
    "SBOM.spdx.json",
    "SOURCE_MANIFEST.json",
    "THIRD_PARTY_NOTICES.generated.md"
  ],
  "asset_paths": [],
  "disclosure_paths": [
    "README.md",
    "src/neutral_tts/local_runtime.py",
    "src/neutral_tts/inference_dialog.py",
    "src/neutral_tts/audioseal_runtime.py",
    "docs/INFERENCE_COMPONENTS.md",
    "config/inference-assets.lock.json",
    "config/inference-sources.lock.json",
    "config/inference-inventory.json",
    "src/neutral_tts/setup.py",
    "docs/TOKENIZER_SETUP.md",
    "tests/test_local_runtime.py",
    "docs/FEATURE_CONTRACTS.md",
    "THIRD_PARTY_NOTICES.md",
    "docs/RELEASE_NO_GO.md",
    "compliance/license-matrix.public.json",
    "compliance/distribution-gates.public.json",
    "config/dependency-closure.lock.json",
    "SBOM.cdx.json",
    "SBOM.spdx.json",
    "SOURCE_MANIFEST.json",
    "THIRD_PARTY_NOTICES.generated.md",
    "docs/WINDOWS_ACCEPTANCE.md"
  ],
  "required_disclosure_paths": [
    "THIRD_PARTY_NOTICES.md",
    "docs/RELEASE_NO_GO.md",
    "compliance/license-matrix.public.json",
    "compliance/distribution-gates.public.json"
  ],
  "always_deny_extensions": [
    ".wav",
    ".mp3",
    ".flac",
    ".ogg",
    ".safetensors",
    ".ckpt",
    ".pt",
    ".pth",
    ".egg-link",
    ".dll",
    ".pyd",
    ".so",
    ".dylib",
    ".exe",
    ".msi",
    ".db",
    ".sqlite",
    ".jsonl"
  ],
  "always_deny_names": [
    "pyvenv.cfg",
    "artifacts.lock.json",
    "playback.lock.json"
  ]
}
